{% extends 'admin/base.html' %}
{% block title %}Категории{% endblock %}

{% block content %}
<h1 class="page-title">Категории</h1>

<form method="post" class="admin-form" enctype="multipart/form-data">
    <label for="name">Име на нова категория</label>
    <input type="text" id="name" name="name" placeholder="напр. Работно облекло" required>

    <label for="image_file">Снимка (по избор)</label>
    <input type="file" id="image_file" name="image_file" accept=".png,.jpg,.jpeg,.webp,.gif">
    <small class="field-hint">Ако не качиш снимка, ще се показва стандартна иконка.</small>

    <div class="admin-form-actions">
        <button type="submit" class="btn">+ Добави категория</button>
    </div>
</form>

<form class="list-toolbar" method="get">
    {% include 'sort_select.html' %}
    <button type="submit" class="btn btn-small">Подреди</button>
    <button type="submit" class="btn btn-small" formmethod="post"
            formaction="{{ url_for('admin_category_order') }}">Запази подредбата в магазина</button>
    <button type="submit" class="btn btn-small" formaction="{{ url_for('admin_categories_export') }}">Експорт CSV</button>
</form>

<table class="admin-table">
    <thead>
        <tr>
            <th>Снимка</th>
            <th>#</th>
            <th>Име</th>
            <th>Брой продукти</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for c in categories %}
        <tr>
            <td>
                {% if c.image_url %}
                    <img src="{{ c.image_url }}" alt="{{ c.name }}" class="admin-category-thumb">
                {% else %}
                    <span class="admin-category-thumb-placeholder">{{ category_icons.get(c.name, '🧰') }}</span>
                {% endif %}
            </td>
            <td>{{ c.id }}</td>
            <td>{{ c.name }}</td>
            <td>{{ c.product_count }}</td>
            <td class="admin-actions">
                <a href="{{ url_for('admin_category_edit', category_id=c.id, sort=sort) }}"
                   class="btn btn-small">Редактирай</a>
                <form action="{{ url_for('admin_category_image', category_id=c.id) }}" method="post"
                      enctype="multipart/form-data" class="category-image-form">
                    <input type="file" name="image_file" accept=".png,.jpg,.jpeg,.webp,.gif"
                           onchange="this.form.submit()" title="Смени снимката">
                </form>
                {% if c.image_url %}
                <form action="{{ url_for('admin_category_image', category_id=c.id) }}" method="post">
                    <input type="hidden" name="remove_image" value="1">
                    <button type="submit" class="btn btn-small btn-secondary">Премахни снимка</button>
                </form>
                {% endif %}
                <form action="{{ url_for('admin_category_delete', category_id=c.id) }}" method="post"
                      onsubmit="return confirm('Изтриване на категория \'{{ c.name }}\'?');">
                    <button type="submit" class="btn btn-small btn-danger">Изтрий</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
